{
    "name": "super-kernel/di",
    "description": "PSR-11 shared-service container with constructor autowiring for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "psr/container": "^2.0.2",
        "psr/log": "^3.0.2",
        "super-kernel/annotator": "self.version",
        "super-kernel/attribute": "self.version",
        "super-kernel/composer": "self.version",
        "super-kernel/contract": "self.version",
        "super-kernel/reflector": "self.version",
        "super-kernel/scan-isolation": "self.version",
        "super-kernel/tokenizer": "self.version"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5",
        "super-kernel/logger": "self.version"
    },
    "provide": {
        "psr/container-implementation": "2.0"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Di\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\Di\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixture/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
